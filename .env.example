# Solana RPC Connection (mainnet-beta, devnet, or custom RPC like Helius/QuickNode)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Agent Keypair (base58 encoded private key; if empty, an ephemeral keypair will be generated)
SOLANA_PRIVATE_KEY=

# Optional LLM API Key (OpenAI, Gemini, Anthropic)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Security Guardrails Configuration
SECURITY_MAX_SOL_PER_TX=5.0
SECURITY_DAILY_SPEND_LIMIT_SOL=20.0
SECURITY_REQUIRE_SIMULATION=true
